# ========================================================
# LTC Intern Tracking System v2 - Environment Variables
# ========================================================
# ຄຳແນະນຳ: ສຳເນົາໄຟລ໌ນີ້ເປັນ .env.local ແລ້ວຕື່ມຄ່າໃຫ້ຄົບຖ້ວນ
# ຫ້າມ Commit ໄຟລ໌ .env.local ຂຶ້ນ Git ເດັດຂາດ!

# --------------------------------------------------------
# Firebase Admin SDK (ສຳລັບ Server API & Custom Claims)
# --------------------------------------------------------
# ວິທີເອົາຄ່າ:
# 1. ເປີດ Firebase Console -> Project Settings -> Service accounts
# 2. ກົດປຸ່ມ "Generate new private key"
# 3. ດາວໂຫຼດໄຟລ໌ JSON ແລ້ວເອົາຄ່າມາໃສ່ດ້ານລຸ່ມ:

FIREBASE_PROJECT_ID="ltc-intern-system"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@ltc-intern-system.iam.gserviceaccount.com"
# ສໍາລັບ Private Key ໃຫ້ໃສ່ເຄື່ອງໝາຍ quote ສອງຊັ້ນ ແລະ ຫ້າມລຶບ \n ອອກ:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ຫຼື ຖ້າສະດວກໃສ່ເປັນ JSON ທັງໝົດໃນຕົວແປດຽວ:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"ltc-intern-system",...}'

# --------------------------------------------------------
# Firebase Client SDK Config (ທາງເລືອກ - ຖ້າຕ້ອງການ override)
# --------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDCvscD4J6OzUN3SwHPUwKUPqKNi8gDtcE"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="ltc-intern-system.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="ltc-intern-system"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="ltc-intern-system.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="261708166872"
NEXT_PUBLIC_FIREBASE_APP_ID="1:261708166872:web:c94bc91241acb71a2489ad"

# --------------------------------------------------------
# ໂໝດທົດສອບເວລາ (Development Only - ໃຊ້ສະເພາະຕອນທົດລອງ)
# --------------------------------------------------------
# ຫ້າມໃຊ້ໃນ Production! ລະບົບຈະກວດສອບ NODE_ENV !== 'production'
# ຖ້າຕ້ອງການຈຳລອງເວລາ ເຊັ່ນ ທົດສອບຕອນ 07:55:00 ຫຼື 17:05:00:
# DEV_FAKE_NOW="2026-04-06T07:55:00+07:00"
